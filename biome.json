{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "!**/node_modules",
      "!**/dist",
      "!**/bun.lock",
      "!apps/pwa/android"
    ]
  }
}
