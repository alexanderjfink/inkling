# Inkling behind nginx.
#
# Copy this into your nginx config and change the three things marked CHANGE ME.
#
# nginx terminates TLS and talks plain HTTP to the container. That is the normal
# arrangement and needs no changes to Inkling: the server serves the app and the API on
# one origin, so `/api` is relative and every request comes back through this block.
# Inkling does not look at X-Forwarded-* or the Host header, so those are here for your
# own logs rather than for it.
#
# The one thing that will actually break you is client_max_body_size — see below.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;                      # nginx < 1.25.1: use `listen 443 ssl http2;` instead

    # CHANGE ME
    server_name blank.homedomain.com;

    # CHANGE ME — your existing certificate for that name.
    ssl_certificate     /etc/letsencrypt/live/blank.homedomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blank.homedomain.com/privkey.pem;

    # ── the line that matters ──────────────────────────────────────────────────────
    # Image capture uploads the whole file as one blob. nginx defaults to 1m, so a phone
    # photo is rejected with a 413 before Inkling ever sees it — and the app reports a
    # failed capture, which looks like a bug in Inkling rather than a setting here.
    # Inkling itself imposes no limit; verified by pushing an 8 MB blob straight at it.
    client_max_body_size 64m;

    location / {
        # CHANGE ME — where the container is.
        #   nginx on the same host  -> 127.0.0.1:8787 (the compose default)
        #   nginx in Docker         -> http://inkling:8787 on a shared network
        #   nginx on another box    -> the host's address, with INKLING_BIND=0.0.0.0
        proxy_pass http://127.0.0.1:8787;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A move asks a model, and a slow one takes longer than nginx's 60s default. When
        # it does, the card sits on "choosing a move…" and then gives up, which reads as
        # the model being broken. Sync pulls and blob transfers can be slow too.
        proxy_connect_timeout 10s;
        proxy_send_timeout    180s;
        proxy_read_timeout    180s;

        # Let uploads and downloads stream instead of being buffered to disk first.
        proxy_request_buffering off;
        proxy_buffering         off;
    }

    # The app is one HTML file naming content-hashed assets, so caching it means an
    # update serves the old app against the new API. Everything else under /assets is
    # named by hash and can be cached forever.
    location = /index.html {
        proxy_pass http://127.0.0.1:8787;
        add_header Cache-Control "no-store" always;
    }

    location /assets/ {
        proxy_pass http://127.0.0.1:8787;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Android fetches this with no session, to prove the APK and the site are the same
    # thing. Only relevant if you build the Trusted Web Activity.
    location = /.well-known/assetlinks.json {
        proxy_pass http://127.0.0.1:8787;
        add_header Cache-Control "no-store" always;
    }
}

# Send plain http to https, so typing the name without a scheme still lands.
server {
    listen 80;
    listen [::]:80;
    server_name blank.homedomain.com;
    return 301 https://$host$request_uri;
}
