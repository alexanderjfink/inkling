{
  "name": "inkling",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @inkling/pwa dev",
    "build": "bun run --filter @inkling/pwa build",
    "test": "bun test",
    "typecheck": "bun run --workspaces typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "typescript": "~6.0.2"
  }
}
